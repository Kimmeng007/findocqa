# Copy to .env and fill in. .env is gitignored.

# Google AI Studio API key (Gemini free tier) - generation, later the LangGraph agent
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# MongoDB Atlas connection string (free-tier cluster)
MONGODB_URI=

# SEC EDGAR requires a real contact identifier on every request
SEC_EDGAR_USER_AGENT=FinDocQA research project (your-email@example.com)
