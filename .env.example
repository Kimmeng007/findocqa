# Copy to .env and fill in. .env is gitignored.

# Anthropic API key (generation, later the LangGraph agent)
ANTHROPIC_API_KEY=

# MongoDB Atlas connection string (free-tier cluster)
MONGODB_URI=

# SEC EDGAR requires a real contact identifier on every request
SEC_EDGAR_USER_AGENT=FinDocQA research project (your-email@example.com)
